# Official public-source APIs
TICKETMASTER_API_KEY=

# TfL road disruption API
TFL_APP_ID=
TFL_APP_KEY=

# National rail routing
# Rail Data Marketplace account is approved. Fill these only after selecting
# the specific RDM data product and confirming its delivery/authentication docs.
RDM_DATA_PRODUCT_ID=
RDM_DELIVERY_ENDPOINT=
RDM_AUTH_MODE=

# AI content generation via Vercel AI Gateway
AI_GATEWAY_API_KEY=
# Optional override. Defaults to openai/gpt-5.6-sol.
AI_GATEWAY_MODEL=
# Required to enable AI routes (Ask AVELA, campaign drafts). Comma-separated emails of
# signed-in accounts allowed to spend model credit. Empty = AI routes are closed for everyone.
AI_ALLOWED_EMAILS=

# Club workspace persistence/authentication.
# Production uses the Vercel Supabase integration with the CLUB prefix.
CLUB_SUPABASE_URL=
CLUB_SUPABASE_PUBLISHABLE_KEY=
# Never commit real keys. Use Vercel/GitHub secrets.

# Cloudflare Turnstile on the public pilot form (/for-clubs). Both empty = no bot check.
# The site key is public and read at build time; the secret key stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email each stored pilot request to the team (Resend). Recipients are comma-separated and live
# only in Vercel, never in the repository. FROM falls back to MORNING_READ_FROM, then Resend's
# test sender, which only delivers to the Resend account owner.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Production deploy trigger: main is deployed automatically by Vercel Git integration.

# Server-only Supabase key used by club workspace writes and server-side lead capture.
# (CLUB_SUPABASE_SERVICE_ROLE_KEY is accepted as the legacy name.) Never expose it to the browser.
CLUB_SUPABASE_SECRET_KEY=

# Morning Commercial Read email (sent once per London day by the daily refresh workflow).
MORNING_READ_TO=
MORNING_READ_FROM=

# Experiment measurement provider (optional). MEASUREMENT_MODE=production sends real events;
# anything else is test mode. Unset URLs mean the provider is shown as not configured.
MEASUREMENT_MODE=
MEASUREMENT_INGEST_URL=
MEASUREMENT_SUMMARY_URL=
MEASUREMENT_WRITE_KEY=

# Optional privacy contact shown on /privacy. Empty = visitors are pointed to the pilot form.
PRIVACY_CONTACT_EMAIL=

# Local and test only: freeze the product date (e2e uses 2026-10-14). Leave empty in production.
AVELA_PRODUCT_DATE=

# Generic work-system webhook (docs/work-system-webhook.md). Approved packages are sent to the
# club's tool (directly or via Zapier/Make/n8n); task status comes back, signed, to
# /api/work-system/callback. Both empty = nothing is ever sent.
WORK_WEBHOOK_URL=
WORK_WEBHOOK_SECRET=

# Frozen internal work-management panels (request tracking, capacity, continuity). Empty = hidden;
# "on" shows them again to review existing data. The club's own tool executes the work.
AVELA_INTERNAL_WORK_MANAGEMENT=
