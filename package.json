{
  "name": "avela-growth-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:permissions && npm run validate:crm-demo && npm run validate:crm-live && npm run validate:public-signals && npm run validate:campaigns && npm run validate:search-demand && npm run validate:experience-demand && npm run validate:mobility-partnership && npm run validate:experiment-measurement && npm run validate:partner-commercial-pack && npm run validate:pilot-readiness && npm run validate:source-health && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && npm run typecheck && npm run check:content",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:e2e": "node scripts/e2e-data.mjs build",
    "e2e:snapshot": "node scripts/e2e-data.mjs snapshot",
    "check:content": "node scripts/check-product-content.mjs",
    "refresh:data": "node scripts/refresh-data.mjs",
    "refresh:public-signals": "node scripts/refresh-public-signals.mjs",
    "refresh:news-radar": "node scripts/refresh-news-radar.mjs",
    "refresh:calendar-moments": "node scripts/refresh-calendar-moments.mjs",
    "refresh:tfl-road": "node scripts/refresh-tfl-road.mjs",
    "refresh:tfl-rail": "node scripts/refresh-tfl-rail.mjs",
    "send:morning-read": "npx -y tsx@4.19.2 --tsconfig tsconfig.json scripts/send-morning-read.ts",
    "import:crm": "node scripts/import-crm-ticketing.mjs",
    "import:trends": "node scripts/import-trends-export.mjs",
    "rehearse:pilot": "node scripts/run-pilot-rehearsal.mjs",
    "validate:crm-demo": "node scripts/validate-crm-ticketing-demo.mjs",
    "validate:crm-live": "node scripts/validate-crm-ticketing-live.mjs",
    "validate:public-signals": "node scripts/validate-public-signals.mjs",
    "validate:campaigns": "node scripts/validate-campaign-plans.mjs",
    "validate:search-demand": "node scripts/validate-search-demand.mjs",
    "validate:experience-demand": "node scripts/validate-experience-demand.mjs",
    "validate:mobility-partnership": "node scripts/validate-mobility-partnership.mjs",
    "validate:experiment-measurement": "node scripts/validate-experiment-measurement.mjs",
    "validate:partner-commercial-pack": "node scripts/validate-partner-commercial-pack.mjs",
    "validate:pilot-readiness": "node scripts/validate-pilot-readiness.mjs",
    "validate:source-health": "node scripts/validate-source-health.mjs",
    "check:permissions": "node scripts/generate-club-permissions-migration.mjs --check"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "unrs-resolver": true
  },
  "engines": {
    "node": "24.x"
  }
}
